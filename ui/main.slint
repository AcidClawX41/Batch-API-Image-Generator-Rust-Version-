// ui/main.slint — Batch Image Generator (Rust + Slint) v2.4.0
// Responsive layout — adapts from ~600px height upward

import { Button, LineEdit, ComboBox, CheckBox, SpinBox, TextEdit,
         GroupBox, ProgressIndicator, VerticalBox, HorizontalBox,
         ScrollView } from "std-widgets.slint";

// ─── Color palette ───
global Theme {
    out property <color> bg: #0d0d0d;
    out property <color> surface: #1a1a1a;
    out property <color> border: #2a2a2a;
    out property <color> text: #e0e0e0;
    out property <color> text-dim: #888888;
    out property <color> accent: #5b8cd4;
    out property <color> green: #6fcf6f;
    out property <color> red: #cf6f6f;
    out property <color> purple: #b08cdf;
    out property <color> cyan: #8ccfdf;
    out property <color> yellow: #f0c674;
    out property <color> orange: #e0a060;
}

export component MainWindow inherits Window {
    title: "Batch Image Generator v2.4 (Rust)";
    min-width: 620px;
    min-height: 580px;
    preferred-width: 980px;
    preferred-height: 1100px;
    background: Theme.bg;
    icon: @image-url("../icons/xai_generator.png");

    // ─── Properties (bound from Rust) ───
    in-out property <string> api-key;
    in-out property <string> wavespeed-api-key;
    in-out property <string> prompt-base;
    in-out property <string> preview-text;
    in-out property <string> log-text;
    in-out property <string> output-folder;
    in-out property <string> status-text: "● DETENIDO";
    in-out property <color>  status-color: Theme.text-dim;
    in-out property <string> countdown-text: "--:--";
    in-out property <int>    generation-count: 0;
    in-out property <float>  progress-value: 0;
    in-out property <bool>   progress-indeterminate: false;
    in-out property <string> progress-label: "Esperando...";

    // Mode selector
    in-out property <int> current-mode: 0; // 0=A, 1=B

    // Model
    in-out property <int> model-index: 0;
    // 0=Auto  1=1k  2=2k  3=4k
    in-out property <int> resolution-idx: 0;
    in-out property <[string]> model-list: [
        // xAI
        "xAI — grok-imagine-image",
        "xAI — grok-imagine-image-pro",
        // Google
        "Google — gemini-2.5-flash-image",
        "Google — gemini-3-pro-image-preview",
        // OpenAI
        "OpenAI — gpt-image-1.5",
        "OpenAI — gpt-image-1",
        "OpenAI — gpt-image-1-mini",
        "OpenAI — dall-e-3 (legacy)",
        // WaveSpeed: Flux 2 (T2I only)
        "WaveSpeed — Flux 2 Max",
        "WaveSpeed — Flux 2 Dev",
        "WaveSpeed — Flux 2 Flash",
        "WaveSpeed — Flux 2 Flex",
        // WaveSpeed: Flux Kontext single (1 img)
        "WaveSpeed — Flux Kontext Max  [1 img]",
        "WaveSpeed — Flux Kontext Pro  [1 img]",
        "WaveSpeed — Flux Kontext Dev  [1 img]",
        // WaveSpeed: Flux Kontext Multi (up to 5 imgs)
        "WaveSpeed — Flux Kontext Max Multi  [★ 5 imgs]",
        "WaveSpeed — Flux Kontext Pro Multi  [★ 5 imgs]",
        // WaveSpeed: WAN I2I
        "WaveSpeed — WAN 2.2  [img→img]",
        "WaveSpeed — WAN 2.6  [img→img]",
        // WaveSpeed: UNO multi-ref
        "WaveSpeed — UNO  [★ multi-ref]",
        // WaveSpeed: other
        "WaveSpeed — Seedream 5.0 Lite",
        "WaveSpeed — Seedream 4.5",
        "WaveSpeed — Nano Banana 2",
        "WaveSpeed — Nano Banana Pro",
        "WaveSpeed — Dreamina 3.1",
        "WaveSpeed — Qwen Image 2.0 Pro",
        "WaveSpeed — Kling O3",
        "WaveSpeed — Grok 2 Image",
        "WaveSpeed — Grok Imagine Image",
        // I2I nativos confirmados
        "WaveSpeed — Grok Imagine Edit  [I2I]",
        "WaveSpeed — Nano Banana 2 Edit  [★ 14 imgs]",
        "WaveSpeed — Nano Banana 2 Edit Fast  [I2I]",
        "WaveSpeed — Nano Banana Pro Edit  [I2I]",
        "WaveSpeed — Seedream 5.0 Lite Edit  [I2I]",
        "WaveSpeed — Seedream 4.5 Edit  [I2I]",
        "WaveSpeed — Qwen Image Edit  [I2I]",
        "WaveSpeed — Flux 2 Klein Edit  [I2I]",
        "WaveSpeed — WAN 2.7 Edit  [I2I]",
        // WaveSpeed: OpenAI GPT Image 2 via WaveSpeed
        "WaveSpeed — GPT Image 2  [OpenAI]",
        "WaveSpeed — GPT Image 2 Edit  [I2I · OpenAI]"
    ];

    // Theme presets for Mode B
    in-out property <int>    theme-index: 0;
    in-out property <[string]> theme-list: [
        "Tsundere School", "Cyberpunk", "Gothic",
        "Miko / Shrine", "Casual Modern", "🎲 Full Random"
    ];

    // Interval
    in-out property <int> interval-secs: 60;

    // Randomizer state (Mode A)
    in-out property <bool> rand-active: false;
    in-out property <bool> chk-nails: true;
    in-out property <bool> chk-orient: true;
    in-out property <bool> chk-expression: false;
    in-out property <bool> chk-outfit: false;
    in-out property <bool> chk-legwear: false;
    in-out property <bool> chk-environment: false;
    in-out property <bool> chk-atmosphere: false;
    in-out property <bool> chk-pose: false;
    in-out property <bool> chk-lighting: false;
    in-out property <bool> chk-camera: false;
    in-out property <bool> chk-rare: false;
    in-out property <bool> chk-accessories: false;
    in-out property <bool> chk-makeup: false;
    in-out property <bool> chk-body-type: false;
    in-out property <bool> chk-age-vibe: false;
    in-out property <bool> chk-color-palette: false;
    in-out property <bool> chk-time-of-day: false;
    in-out property <bool> chk-weather: false;
    in-out property <bool> chk-bg-props: false;
    in-out property <bool> chk-material: false;
    in-out property <bool> chk-motion: false;

    // Mode B options
    in-out property <bool> chk-curated: false;
    in-out property <bool> chk-auto-b: true;

    // Running state
    in-out property <bool> is-running: false;
    in-out property <bool> key-visible: false;

    // ─── Image-to-Image properties ───
    in-out property <string> ref-image-path: "";
    in-out property <bool>   ref-image-loaded: false;
    in-out property <string> ref-image2-path: "";
    in-out property <bool>   ref-image2-loaded: false;
    // Extra slots for multi-ref models (Flux Kontext Multi, UNO)
    in-out property <string> ref-image3-path: "";
    in-out property <bool>   ref-image3-loaded: false;
    in-out property <string> ref-image4-path: "";
    in-out property <bool>   ref-image4-loaded: false;
    in-out property <string> ref-image5-path: "";
    in-out property <bool>   ref-image5-loaded: false;
    // 0 = Referencia de estilo, 1 = Edición directa
    in-out property <int>    i2i-mode-index: 0;

    // ─── Callbacks (handled in Rust) ───
    callback start-loop();
    callback stop-loop();
    callback start-burst();
    callback single-generate();
    callback toggle-randomizer();
    callback gen-preview-b();
    callback browse-folder();
    callback browse-ref-image();
    callback clear-ref-image();
    callback browse-ref-image2();
    callback clear-ref-image2();
    callback browse-ref-image3();
    callback clear-ref-image3();
    callback browse-ref-image4();
    callback clear-ref-image4();
    callback browse-ref-image5();
    callback clear-ref-image5();

    // ─── Main scrollable area ───
    ScrollView {
        VerticalBox {
            padding: 14px;
            spacing: 8px;

            // ── Header ──
            HorizontalBox {
                alignment: space-between;
                Text {
                    text: "⚡ Batch Image Generator v2.4";
                    font-size: 17px;
                    font-weight: 700;
                    color: white;
                    vertical-alignment: center;
                }
                Rectangle {
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 4px;
                    width: 120px;
                    height: 26px;
                    Text {
                        text: root.status-text;
                        color: root.status-color;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // ── API Keys ──
            GroupBox {
                title: "API Keys";
                VerticalBox {
                    spacing: 6px;
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "xAI/Google/OpenAI:"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; min-width: 130px; }
                        LineEdit {
                            text <=> root.api-key;
                            placeholder-text: "API key de xAI, Google o OpenAI";
                            input-type: root.key-visible ? InputType.text : InputType.password;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: root.key-visible ? "🔒" : "👁";
                            max-width: 40px;
                            clicked => { root.key-visible = !root.key-visible; }
                        }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "WaveSpeed.ai:"; color: Theme.cyan; font-size: 11px; vertical-alignment: center; min-width: 130px; }
                        LineEdit {
                            text <=> root.wavespeed-api-key;
                            placeholder-text: "API key de WaveSpeed.ai (Flux, Seedream, etc.)";
                            input-type: root.key-visible ? InputType.text : InputType.password;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            // ── Mode selector ──
            HorizontalBox {
                spacing: 8px;
                alignment: start;
                Text {
                    text: "Modo:";
                    color: Theme.text-dim;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                ComboBox {
                    model: ["A — Prompt manual + randomizer", "B — Prompt auto-generado (pools)"];
                    current-index <=> root.current-mode;
                    horizontal-stretch: 1;
                    min-width: 250px;
                }
            }

            // ── MODE A ──
            if root.current-mode == 0 : VerticalBox {
                spacing: 6px;

                GroupBox {
                    title: "Prompt (base)";
                    TextEdit {
                        text <=> root.prompt-base;
                        min-height: 60px;
                        vertical-stretch: 1;
                    }
                }

                GroupBox {
                    title: "🎲 Randomizer (Mode A)";

                    VerticalBox {
                        spacing: 5px;

                        HorizontalBox {
                            Button {
                                text: root.rand-active ? "🎲  Aleatorio: ON" : "🎲  Aleatorio: OFF";
                                min-height: 30px;
                                clicked => { root.toggle-randomizer(); }
                            }
                        }

                        HorizontalBox {
                            spacing: 0px;
                            alignment: start;
                            Text { text: "Reemplazar:"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; width: 80px; }
                            CheckBox { text: "Uñas";        checked <=> root.chk-nails;      enabled: root.rand-active; width: 120px; }
                            CheckBox { text: "Orientación"; checked <=> root.chk-orient;     enabled: root.rand-active; width: 140px; }
                            CheckBox { text: "Expresión";   checked <=> root.chk-expression; enabled: root.rand-active; width: 140px; }
                        }

                        HorizontalBox {
                            spacing: 0px;
                            alignment: start;
                            Text { text: "Inyectar:"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; width: 80px; }
                            CheckBox { text: "Ropa";       checked <=> root.chk-outfit;      enabled: root.rand-active; width: 120px; }
                            CheckBox { text: "Medias";     checked <=> root.chk-legwear;     enabled: root.rand-active; width: 140px; }
                            CheckBox { text: "Escenario";  checked <=> root.chk-environment; enabled: root.rand-active; width: 140px; }
                            CheckBox { text: "Atmósfera";  checked <=> root.chk-atmosphere;  enabled: root.rand-active; width: 140px; }
                        }

                        HorizontalBox {
                            spacing: 0px;
                            alignment: start;
                            Rectangle { width: 80px; }
                            CheckBox { text: "Pose";           checked <=> root.chk-pose;     enabled: root.rand-active; width: 120px; }
                            CheckBox { text: "Luz";            checked <=> root.chk-lighting; enabled: root.rand-active; width: 140px; }
                            CheckBox { text: "Cámara";         checked <=> root.chk-camera;   enabled: root.rand-active; width: 140px; }
                            CheckBox { text: "Detalles Raros"; checked <=> root.chk-rare;     enabled: root.rand-active; width: 140px; }
                        }

                        HorizontalBox {
                            spacing: 0px;
                            alignment: start;
                            Text { text: "Personaje:"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; width: 80px; }
                            CheckBox { text: "Accesorios"; checked <=> root.chk-accessories; enabled: root.rand-active; width: 120px; }
                            CheckBox { text: "Maquillaje"; checked <=> root.chk-makeup;      enabled: root.rand-active; width: 140px; }
                            CheckBox { text: "Silueta";    checked <=> root.chk-body-type;   enabled: root.rand-active; width: 140px; }
                            CheckBox { text: "Edad";       checked <=> root.chk-age-vibe;    enabled: root.rand-active; width: 140px; }
                        }

                        HorizontalBox {
                            spacing: 0px;
                            alignment: start;
                            Text { text: "Escena:"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; width: 80px; }
                            CheckBox { text: "Paleta color"; checked <=> root.chk-color-palette; enabled: root.rand-active; width: 120px; }
                            CheckBox { text: "Hora del día"; checked <=> root.chk-time-of-day;   enabled: root.rand-active; width: 140px; }
                            CheckBox { text: "Clima";        checked <=> root.chk-weather;       enabled: root.rand-active; width: 140px; }
                        }

                        HorizontalBox {
                            spacing: 0px;
                            alignment: start;
                            Rectangle { width: 80px; }
                            CheckBox { text: "Props fondo"; checked <=> root.chk-bg-props; enabled: root.rand-active; width: 120px; }
                            CheckBox { text: "Material";    checked <=> root.chk-material; enabled: root.rand-active; width: 140px; }
                            CheckBox { text: "Movimiento";  checked <=> root.chk-motion;   enabled: root.rand-active; width: 140px; }
                        }
                    }
                }
            }

            // ── MODE B ──
            if root.current-mode == 1 : GroupBox {
                title: "🎰 Auto-Generador (Mode B)";

                VerticalBox {
                    spacing: 8px;

                    HorizontalBox {
                        spacing: 10px;
                        Text { text: "Tema:"; color: Theme.text-dim; vertical-alignment: center; }
                        ComboBox {
                            model: root.theme-list;
                            current-index <=> root.theme-index;
                            horizontal-stretch: 1;
                            min-width: 180px;
                        }
                        CheckBox { text: "Combos curados"; checked <=> root.chk-curated; }
                    }

                    HorizontalBox {
                        spacing: 10px;
                        Button {
                            text: "🎰  Generar nuevo prompt";
                            min-height: 30px;
                            clicked => { root.gen-preview-b(); }
                        }
                        CheckBox { text: "Auto en loop"; checked <=> root.chk-auto-b; }
                    }
                }
            }

            // ── Preview ──
            GroupBox {
                title: "Preview del prompt";
                TextEdit {
                    text <=> root.preview-text;
                    read-only: true;
                    min-height: 50px;
                    vertical-stretch: 1;
                    wrap: word-wrap;
                }
            }

            // ── 🖼 Image-to-Image Conditioning ──
            GroupBox {
                title: "🖼 Image-to-Image Conditioning";

                VerticalBox {
                    spacing: 8px;

                    // ── IMAGEN 1: persona / estilo ──
                    HorizontalBox {
                        spacing: 0px; alignment: start;
                        Text { text: "Img 1 (persona):"; color: Theme.text-dim; font-size: 10px; font-weight: 700; vertical-alignment: center; min-width: 110px; }
                        Rectangle {
                            height: 28px; border-radius: 4px; border-width: 1px;
                            background: root.ref-image-loaded ? #112211 : Theme.surface;
                            border-color: root.ref-image-loaded ? Theme.green : Theme.border;
                            horizontal-stretch: 1;
                            HorizontalBox {
                                padding-left: 8px; spacing: 6px; alignment: start;
                                Text { text: root.ref-image-loaded ? "🟢" : "⚪"; font-size: 12px; vertical-alignment: center; }
                                Text {
                                    text: root.ref-image-loaded ? root.ref-image-path : "Sin imagen — solo texto";
                                    color: root.ref-image-loaded ? Theme.green : Theme.text-dim;
                                    font-size: 10px; font-weight: root.ref-image-loaded ? 700 : 400;
                                    vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                                }
                            }
                        }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Rectangle { min-width: 110px; horizontal-stretch: 0; }
                        Button { text: "📂  Seleccionar imagen 1"; min-height: 28px; horizontal-stretch: 1; clicked => { root.browse-ref-image(); } }
                        Button { text: "🗑"; min-height: 28px; enabled: root.ref-image-loaded; min-width: 40px; horizontal-stretch: 0; clicked => { root.clear-ref-image(); } }
                    }

                    // ── IMAGEN 2: escena / vehículo ──
                    HorizontalBox {
                        spacing: 0px; alignment: start;
                        Text { text: "Img 2 (escena):"; color: root.ref-image2-loaded ? Theme.cyan : Theme.text-dim; font-size: 10px; font-weight: 700; vertical-alignment: center; min-width: 110px; }
                        Rectangle {
                            height: 28px; border-radius: 4px; border-width: 1px;
                            background: root.ref-image2-loaded ? #111222 : Theme.surface;
                            border-color: root.ref-image2-loaded ? Theme.cyan : Theme.border;
                            horizontal-stretch: 1;
                            HorizontalBox {
                                padding-left: 8px; spacing: 6px; alignment: start;
                                Text { text: root.ref-image2-loaded ? "🔵" : "⚪"; font-size: 12px; vertical-alignment: center; }
                                Text {
                                    text: root.ref-image2-loaded ? root.ref-image2-path : "Opcional — xAI Grok, Flux Kontext Multi, UNO";
                                    color: root.ref-image2-loaded ? Theme.cyan : Theme.text-dim;
                                    font-size: 10px; font-weight: root.ref-image2-loaded ? 700 : 400;
                                    vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                                }
                            }
                        }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Rectangle { min-width: 110px; horizontal-stretch: 0; }
                        Button { text: "📂  Seleccionar imagen 2"; min-height: 28px; horizontal-stretch: 1; clicked => { root.browse-ref-image2(); } }
                        Button { text: "🗑"; min-height: 28px; enabled: root.ref-image2-loaded; min-width: 40px; horizontal-stretch: 0; clicked => { root.clear-ref-image2(); } }
                    }

                    // ── IMAGEN 3: extra (multi-ref) ──
                    HorizontalBox {
                        spacing: 0px; alignment: start;
                        Text { text: "Img 3 (extra):"; color: root.ref-image3-loaded ? Theme.purple : Theme.text-dim; font-size: 10px; font-weight: 700; vertical-alignment: center; min-width: 110px; }
                        Rectangle {
                            height: 28px; border-radius: 4px; border-width: 1px;
                            background: root.ref-image3-loaded ? #1a1122 : Theme.surface;
                            border-color: root.ref-image3-loaded ? Theme.purple : Theme.border;
                            horizontal-stretch: 1;
                            HorizontalBox {
                                padding-left: 8px; spacing: 6px; alignment: start;
                                Text { text: root.ref-image3-loaded ? "🟣" : "⚪"; font-size: 12px; vertical-alignment: center; }
                                Text {
                                    text: root.ref-image3-loaded ? root.ref-image3-path : "★ Solo Flux Kontext Multi / UNO";
                                    color: root.ref-image3-loaded ? Theme.purple : Theme.text-dim;
                                    font-size: 10px; font-weight: root.ref-image3-loaded ? 700 : 400;
                                    vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                                }
                            }
                        }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Rectangle { min-width: 110px; horizontal-stretch: 0; }
                        Button { text: "📂  Seleccionar imagen 3"; min-height: 28px; horizontal-stretch: 1; clicked => { root.browse-ref-image3(); } }
                        Button { text: "🗑"; min-height: 28px; enabled: root.ref-image3-loaded; min-width: 40px; horizontal-stretch: 0; clicked => { root.clear-ref-image3(); } }
                    }

                    // ── IMAGEN 4: extra (multi-ref) ──
                    HorizontalBox {
                        spacing: 0px; alignment: start;
                        Text { text: "Img 4 (extra):"; color: root.ref-image4-loaded ? Theme.orange : Theme.text-dim; font-size: 10px; font-weight: 700; vertical-alignment: center; min-width: 110px; }
                        Rectangle {
                            height: 28px; border-radius: 4px; border-width: 1px;
                            background: root.ref-image4-loaded ? #1a1208 : Theme.surface;
                            border-color: root.ref-image4-loaded ? Theme.orange : Theme.border;
                            horizontal-stretch: 1;
                            HorizontalBox {
                                padding-left: 8px; spacing: 6px; alignment: start;
                                Text { text: root.ref-image4-loaded ? "🟠" : "⚪"; font-size: 12px; vertical-alignment: center; }
                                Text {
                                    text: root.ref-image4-loaded ? root.ref-image4-path : "★ Solo Flux Kontext Multi / UNO";
                                    color: root.ref-image4-loaded ? Theme.orange : Theme.text-dim;
                                    font-size: 10px; font-weight: root.ref-image4-loaded ? 700 : 400;
                                    vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                                }
                            }
                        }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Rectangle { min-width: 110px; horizontal-stretch: 0; }
                        Button { text: "📂  Seleccionar imagen 4"; min-height: 28px; horizontal-stretch: 1; clicked => { root.browse-ref-image4(); } }
                        Button { text: "🗑"; min-height: 28px; enabled: root.ref-image4-loaded; min-width: 40px; horizontal-stretch: 0; clicked => { root.clear-ref-image4(); } }
                    }

                    // ── IMAGEN 5: extra (multi-ref) ──
                    HorizontalBox {
                        spacing: 0px; alignment: start;
                        Text { text: "Img 5 (extra):"; color: root.ref-image5-loaded ? Theme.yellow : Theme.text-dim; font-size: 10px; font-weight: 700; vertical-alignment: center; min-width: 110px; }
                        Rectangle {
                            height: 28px; border-radius: 4px; border-width: 1px;
                            background: root.ref-image5-loaded ? #1a1a08 : Theme.surface;
                            border-color: root.ref-image5-loaded ? Theme.yellow : Theme.border;
                            horizontal-stretch: 1;
                            HorizontalBox {
                                padding-left: 8px; spacing: 6px; alignment: start;
                                Text { text: root.ref-image5-loaded ? "🟡" : "⚪"; font-size: 12px; vertical-alignment: center; }
                                Text {
                                    text: root.ref-image5-loaded ? root.ref-image5-path : "★ Solo Flux Kontext Multi / UNO";
                                    color: root.ref-image5-loaded ? Theme.yellow : Theme.text-dim;
                                    font-size: 10px; font-weight: root.ref-image5-loaded ? 700 : 400;
                                    vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                                }
                            }
                        }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Rectangle { min-width: 110px; horizontal-stretch: 0; }
                        Button { text: "📂  Seleccionar imagen 5"; min-height: 28px; horizontal-stretch: 1; clicked => { root.browse-ref-image5(); } }
                        Button { text: "🗑"; min-height: 28px; enabled: root.ref-image5-loaded; min-width: 40px; horizontal-stretch: 0; clicked => { root.clear-ref-image5(); } }
                    }

                    // ── Mode selector ──
                    HorizontalBox {
                        spacing: 10px; alignment: start;
                        Text {
                            text: "Modo I2I:";
                            color: root.ref-image-loaded ? Theme.text : Theme.text-dim;
                            font-size: 11px; font-weight: 700; vertical-alignment: center; min-width: 110px;
                        }
                        ComboBox {
                            model: [
                                "Referencia de estilo  (prompt guía el contenido)",
                                "Edición directa  (transforma la imagen)"
                            ];
                            current-index <=> root.i2i-mode-index;
                            enabled: root.ref-image-loaded;
                            horizontal-stretch: 1;
                            min-width: 260px;
                        }
                    }

                    // ── Info note ──
                    Text {
                        text: {
                            if (root.ref-image5-loaded || root.ref-image4-loaded || root.ref-image3-loaded) {
                                "★ Multi-ref activo — usa Flux Kontext Multi o UNO para aprovechar las 5 imágenes."
                            } else if (root.ref-image-loaded && root.ref-image2-loaded) {
                                "✅ 2 imágenes activas — xAI Grok (combina persona+escena) · Flux Kontext Multi / UNO (multi-ref)."
                            } else if (root.ref-image-loaded) {
                                "✅ Imagen 1 activa — xAI, OpenAI, WaveSpeed Flux Kontext, WAN. Randomizer sigue activo."
                            } else {
                                "ℹ Img 1+2: xAI Grok · Img 1: OpenAI/Flux Kontext/WAN · Imgs 1-5: Flux Kontext Multi / UNO"
                            }
                        };
                        color: (root.ref-image3-loaded || root.ref-image4-loaded || root.ref-image5-loaded) ? Theme.purple
                             : root.ref-image-loaded ? Theme.green
                             : Theme.text-dim;
                        font-size: 10px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }

            // ── Configuration ──
            GroupBox {
                title: "Configuración";
                VerticalBox {
                    spacing: 6px;
                    HorizontalBox {
                        spacing: 12px;
                        Text { text: "Modelo / proveedor:"; color: Theme.text-dim; vertical-alignment: center; }
                        ComboBox {
                            model: root.model-list;
                            current-index <=> root.model-index;
                            horizontal-stretch: 1;
                            min-width: 180px;
                        }
                        Text { text: "Resolución:"; color: Theme.text-dim; vertical-alignment: center; }
                        ComboBox {
                            model: ["Auto", "1k (1024)", "2k (2048)", "4k (4096)"];
                            current-index <=> root.resolution-idx;
                            min-width: 110px;
                        }
                        Text { text: "Intervalo:"; color: Theme.text-dim; vertical-alignment: center; }
                        SpinBox { value <=> root.interval-secs; minimum: 10; maximum: 600; }
                        Text { text: "seg"; color: Theme.text-dim; vertical-alignment: center; }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "Carpeta:"; color: Theme.text-dim; vertical-alignment: center; }
                        LineEdit { text <=> root.output-folder; horizontal-stretch: 1; }
                        Button { text: "📂"; max-width: 40px; clicked => { root.browse-folder(); } }
                    }
                }
            }

            // ── Control buttons ──
            // Row 1: Loop + Burst + Stop
            HorizontalBox {
                spacing: 8px;
                Button {
                    text: "▶  Iniciar Loop";
                    enabled: !root.is-running;
                    min-height: 36px;
                    horizontal-stretch: 1;
                    clicked => { root.start-loop(); }
                }
                Button {
                    text: "⚡⚡ Burst";
                    enabled: !root.is-running;
                    min-height: 36px;
                    horizontal-stretch: 1;
                    // Highlight burst button with a warm accent
                    colorize-icon: false;
                    clicked => { root.start-burst(); }
                }
                Button {
                    text: "■  Detener";
                    enabled: root.is-running;
                    min-height: 36px;
                    horizontal-stretch: 1;
                    clicked => { root.stop-loop(); }
                }
            }
            // Row 2: Single generate + info
            HorizontalBox {
                spacing: 8px;
                Button {
                    text: "⚡ Generar 1";
                    enabled: !root.is-running;
                    min-height: 30px;
                    horizontal-stretch: 1;
                    clicked => { root.single-generate(); }
                }
                Rectangle {
                    horizontal-stretch: 2;
                    Text {
                        text: "Loop: espera X seg entre imgs · Burst: continuo sin pausa";
                        color: Theme.text-dim;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            // ── Progress ──
            VerticalBox {
                spacing: 4px;
                HorizontalBox {
                    spacing: 10px;
                    ProgressIndicator {
                        progress: root.progress-indeterminate ? -1 : root.progress-value;
                        horizontal-stretch: 1;
                        min-height: 14px;
                    }
                    Text { text: root.countdown-text; color: Theme.accent; font-size: 15px; font-weight: 700; min-width: 55px; horizontal-alignment: center; }
                    Text { text: root.generation-count; color: Theme.accent; font-size: 22px; font-weight: 700; min-width: 45px; horizontal-alignment: center; }
                    Text { text: "imgs"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
                }
                Text {
                    text: root.progress-label;
                    color: root.progress-label == "Completado" ? Theme.green
                         : root.progress-label == "Error"      ? Theme.red
                         : root.progress-label == "Detenido"   ? Theme.text-dim
                         : Theme.cyan;
                    font-size: 11px;
                    horizontal-alignment: right;
                }
            }

            // ── Log ──
            GroupBox {
                title: "Log";
                TextEdit {
                    text <=> root.log-text;
                    read-only: true;
                    min-height: 70px;
                    vertical-stretch: 2;
                    wrap: word-wrap;
                }
            }
        }
    }
}
