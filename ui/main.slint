// ui/main.slint — Batch Image Generator (Rust + Slint) v2.5.0
//
// Eric Valls Gramunt
//
// Interfaz construida íntegramente sobre controles propios (`widgets.slint`)
// y una paleta conmutable (`theme.slint`). No se importa `std-widgets.slint`:
// así el aspecto no depende de la paleta del escritorio y es idéntico en
// Linux, Windows y macOS.

import { Theme } from "theme.slint";
import { TButton, TCheckBox, TLineEdit, TTextEdit, TComboBox,
         TSpinBox, TProgress, TGroupBox, TScrollView } from "widgets.slint";

export { Theme }

// ─── Fila reutilizable de slot de imagen ────────────────────────────
// Evita repetir cinco veces el mismo bloque de 25 líneas.
component RefImageRow inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> dot;
    in property <string> path;
    in property <bool> loaded;
    in property <color> tone;
    in property <color> tint;
    /// Número de hueco (1-5) y máximo real del modelo seleccionado.
    ///
    /// Antes las pistas eran texto fijo con nombres de modelo dentro, y se
    /// quedaban desfasadas en cuanto cambiaba la tabla. Ahora salen del propio
    /// modelo elegido: si carga una imagen que ese modelo va a descartar, se
    /// dice **aquí**, no después en el log.
    in property <int> slot: 1;
    in property <int> max-refs: 5;
    property <bool> descartada: root.slot > root.max-refs;
    callback browse();
    callback clear();

    spacing: 5px;

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.label;
            color: root.loaded ? root.tone : Theme.text-dim;
            font-size: 10.5px;
            font-weight: 700;
            vertical-alignment: center;
            width: 110px;
        }
        Rectangle {
            height: 28px;
            border-radius: Theme.radius;
            border-width: 1px;
            background: root.loaded ? root.tint : Theme.field;
            border-color: root.descartada && root.loaded ? Theme.orange
                        : root.loaded ? root.tone
                        : Theme.border;
            horizontal-stretch: 1;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                Text { text: root.dot; font-size: 12px; vertical-alignment: center; }
                Text {
                    text: root.loaded && root.descartada ? "⚠ " + root.path + "  — el modelo elegido no la usará"
                        : root.loaded ? root.path
                        : root.descartada ? "El modelo elegido no admite esta imagen"
                        : root.hint;
                    color: root.loaded && root.descartada ? Theme.orange
                         : root.loaded ? root.tone
                         : Theme.text-dim;
                    font-size: 10.5px;
                    font-weight: root.loaded ? 700 : 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Rectangle { width: 110px; }
        TButton {
            text: "📂  Seleccionar " + root.label;
            min-height: 28px;
            horizontal-stretch: 1;
            clicked => { root.browse(); }
        }
        TButton {
            text: "🗑";
            min-height: 28px;
            width: 42px;
            enabled: root.loaded;
            clicked => { root.clear(); }
        }
    }
}

export component MainWindow inherits Window {
    title: "Batch Image Generator v2.5 (Rust)";
    min-width: 620px;
    min-height: 580px;
    preferred-width: 1000px;
    preferred-height: 1100px;
    background: Theme.bg;
    icon: @image-url("../icons/xai_generator.png");

    // ─── Skin ───────────────────────────────────────────────────────────
    // 0 = Oscuro · 1 = Claro · 2 = Cyberpunk
    // Se carga desde la configuración al arrancar y se guarda al cambiar.
    in-out property <int> skin-index: 0;
    callback skin-changed();

    // `init` sólo cubre el arranque, y se ejecuta ANTES de que Rust vuelque
    // la configuración guardada. `changed` mantiene la paleta sincronizada
    // venga el cambio de donde venga: del desplegable o de config.json.
    init => { Theme.skin = root.skin-index; }
    changed skin-index => { Theme.skin = root.skin-index; }

    // ─── Propiedades enlazadas desde Rust ───────────────────────────────
    in-out property <string> api-key;
    in-out property <string> wavespeed-api-key;
    in-out property <string> kie-api-key;
    in-out property <string> prompt-base;
    in-out property <string> preview-text;
    in-out property <string> log-text;
    in-out property <string> output-folder;
    in-out property <string> status-text: "● DETENIDO";
    in-out property <color>  status-color: Theme.text-dim;
    in-out property <string> countdown-text: "--:--";
    in-out property <int>    generation-count: 0;
    in-out property <float>  progress-value: 0;
    in-out property <bool>   progress-indeterminate: false;
    in-out property <string> progress-label: "Esperando...";

    in-out property <int> current-mode: 0; // 0=A, 1=B

    in-out property <int> model-index: 0;
    // 0=Auto  1=1k  2=2k  3=4k
    in-out property <int> resolution-idx: 0;
    // La lista de modelos la rellena Rust desde `src/models.rs` al arrancar.
    // Antes estaba escrita aquí a mano y tenía que coincidir en contenido y
    // en orden con `MODEL_CATALOG`: si se desincronizaban, el desplegable
    // mostraba un nombre y se enviaba otro modelo. Ahora hay una sola fuente.
    in-out property <[string]> model-list: [];
    /// Máximo de imágenes de referencia por modelo, en el mismo orden que
    /// `model-list`. Lo rellena Rust desde la tabla de modelos, así que la
    /// interfaz no puede contradecir a lo que se envía.
    in-out property <[int]> model-max-refs-list: [];
    property <int> model-max-refs:
        root.model-index >= 0 && root.model-index < root.model-max-refs-list.length
            ? root.model-max-refs-list[root.model-index]
            : 1;
    property <int> ref-images-loaded:
        (root.ref-image-loaded  ? 1 : 0) + (root.ref-image2-loaded ? 1 : 0)
      + (root.ref-image3-loaded ? 1 : 0) + (root.ref-image4-loaded ? 1 : 0)
      + (root.ref-image5-loaded ? 1 : 0);

    in-out property <int>    theme-index: 0;
    in-out property <[string]> theme-list: [
        "Tsundere School", "Cyberpunk", "Gothic",
        "Miko / Shrine", "Casual Modern", "🎲 Full Random"
    ];

    in-out property <int> interval-secs: 60;

    // Randomizer (Mode A)
    in-out property <bool> rand-active: false;
    // Super Randomizer: sortea en cada generación cuántas categorías
    // entran y cuáles. No sustituye al modo manual, convive con él.
    in-out property <bool> super-rand-active: false;
    in-out property <bool> chk-nails: true;
    in-out property <bool> chk-orient: true;
    in-out property <bool> chk-expression: false;
    in-out property <bool> chk-outfit: false;
    in-out property <bool> chk-legwear: false;
    in-out property <bool> chk-environment: false;
    in-out property <bool> chk-atmosphere: false;
    in-out property <bool> chk-pose: false;
    in-out property <bool> chk-lighting: false;
    in-out property <bool> chk-camera: false;
    in-out property <bool> chk-rare: false;
    in-out property <bool> chk-accessories: false;
    in-out property <bool> chk-makeup: false;
    in-out property <bool> chk-body-type: false;
    in-out property <bool> chk-age-vibe: false;
    in-out property <bool> chk-color-palette: false;
    in-out property <bool> chk-time-of-day: false;
    in-out property <bool> chk-weather: false;
    in-out property <bool> chk-bg-props: false;
    in-out property <bool> chk-material: false;
    in-out property <bool> chk-motion: false;

    // ─── Banco de prompts (Modo A) ───
    // Los textos viven en Rust; aquí sólo el índice de ranura, un resumen
    // legible de cuáles están ocupadas y el interruptor de sorteo.
    in-out property <int> prompt-slot-index: 0;
    in-out property <string> prompt-slots-summary: "1 —  ·  2 —  ·  3 —  ·  4 —  ·  5 —";
    in-out property <bool> prompt-random-active: false;

    // ─── Notificaciones de escritorio ───
    in-out property <bool> notify-enabled: false;
    in-out property <bool> notify-success: false;
    in-out property <bool> notify-timeout: true;
    in-out property <bool> notify-policy: true;
    in-out property <bool> notify-other: true;

    in-out property <bool> chk-curated: false;
    in-out property <bool> chk-auto-b: true;

    in-out property <bool> is-running: false;
    in-out property <bool> key-visible: false;

    // Imágenes de referencia
    in-out property <string> ref-image-path: "";
    in-out property <bool>   ref-image-loaded: false;
    in-out property <string> ref-image2-path: "";
    in-out property <bool>   ref-image2-loaded: false;
    in-out property <string> ref-image3-path: "";
    in-out property <bool>   ref-image3-loaded: false;
    in-out property <string> ref-image4-path: "";
    in-out property <bool>   ref-image4-loaded: false;
    in-out property <string> ref-image5-path: "";
    in-out property <bool>   ref-image5-loaded: false;

    in-out property <int>    i2i-mode-index: 0;

    // ─── Callbacks ──────────────────────────────────────────────────────
    callback start-loop();
    callback stop-loop();
    callback start-burst();
    callback single-generate();
    callback toggle-randomizer();
    callback toggle-super-randomizer();
    callback save-prompt-slot();
    callback load-prompt-slot();
    callback clear-prompt-slot();
    callback toggle-prompt-random();
    callback toggle-notifications();
    callback test-notification();
    callback gen-preview-b();
    callback browse-folder();
    callback browse-ref-image();
    callback clear-ref-image();
    callback browse-ref-image2();
    callback clear-ref-image2();
    callback browse-ref-image3();
    callback clear-ref-image3();
    callback browse-ref-image4();
    callback clear-ref-image4();
    callback browse-ref-image5();
    callback clear-ref-image5();

    // ─── Contenido ──────────────────────────────────────────────────────
    TScrollView {
        viewport-height: content.preferred-height;

        content := VerticalLayout {
            width: 100%;
            height: self.preferred-height;
            padding: 14px;
            spacing: 9px;

            // ── Cabecera ──
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "⚡ Batch Image Generator v2.5";
                    font-size: 17px;
                    font-weight: 800;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "Skin:";
                    color: Theme.text-dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                TComboBox {
                    model: ["🌙  Oscuro", "☀  Claro", "🌆  Cyberpunk"];
                    current-index <=> root.skin-index;
                    width: 145px;
                    selected => {
                        Theme.skin = root.skin-index;
                        root.skin-changed();
                    }
                }
                Rectangle {
                    background: Theme.surface;
                    border-color: root.status-color;
                    border-width: 1px;
                    border-radius: Theme.radius;
                    width: 124px;
                    height: 28px;
                    Text {
                        text: root.status-text;
                        color: root.status-color;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // ── API Keys ──
            TGroupBox {
                title: "API Keys";
                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "xAI/Google/OpenAI:";
                            color: Theme.text-dim;
                            font-size: 11px;
                            vertical-alignment: center;
                            width: 132px;
                        }
                        TLineEdit {
                            text <=> root.api-key;
                            placeholder-text: "API key de xAI, Google o OpenAI";
                            password: !root.key-visible;
                            horizontal-stretch: 1;
                        }
                        TButton {
                            text: root.key-visible ? "🔒" : "👁";
                            width: 44px;
                            clicked => { root.key-visible = !root.key-visible; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "WaveSpeed.ai:";
                            color: Theme.cyan;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                            width: 132px;
                        }
                        TLineEdit {
                            text <=> root.wavespeed-api-key;
                            placeholder-text: "API key de WaveSpeed.ai (Flux, Seedream, etc.)";
                            password: !root.key-visible;
                            horizontal-stretch: 1;
                        }
                        Rectangle { width: 44px; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Kie.AI:";
                            color: Theme.purple;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                            width: 132px;
                        }
                        TLineEdit {
                            text <=> root.kie-api-key;
                            placeholder-text: "API key de Kie.AI (GPT Image 2, Nano Banana, Seedream)";
                            password: !root.key-visible;
                            horizontal-stretch: 1;
                        }
                        Rectangle { width: 44px; }
                    }
                }
            }

            // ── Selector de modo ──
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Modo:";
                    color: Theme.text-dim;
                    font-weight: 700;
                    font-size: 11.5px;
                    vertical-alignment: center;
                    width: 50px;
                }
                TComboBox {
                    model: ["A — Prompt manual + randomizer", "B — Prompt auto-generado (pools)"];
                    current-index <=> root.current-mode;
                    horizontal-stretch: 1;
                }
            }

            // ── MODO A ──
            if root.current-mode == 0: VerticalLayout {
                spacing: 9px;

                TGroupBox {
                    title: "Prompt (base)";
                    VerticalLayout {
                        spacing: 7px;

                        TTextEdit {
                            text <=> root.prompt-base;
                            height: 78px;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "Banco:";
                                color: Theme.text-dim;
                                font-size: 11px;
                                vertical-alignment: center;
                                width: 52px;
                            }
                            TComboBox {
                                model: ["Ranura 1", "Ranura 2", "Ranura 3", "Ranura 4", "Ranura 5"];
                                current-index <=> root.prompt-slot-index;
                                width: 116px;
                            }
                            TButton {
                                text: "💾 Guardar";
                                width: 108px;
                                clicked => { root.save-prompt-slot(); }
                            }
                            TButton {
                                text: "📂 Cargar";
                                width: 100px;
                                clicked => { root.load-prompt-slot(); }
                            }
                            TButton {
                                text: "🗑 Vaciar";
                                width: 96px;
                                clicked => { root.clear-prompt-slot(); }
                            }
                            TButton {
                                text: root.prompt-random-active
                                    ? "🎲 Prompt aleatorio: ON"
                                    : "🎲 Prompt aleatorio: OFF";
                                horizontal-stretch: 1;
                                use-accent-color: root.prompt-random-active;
                                accent-color: Theme.cyan;
                                clicked => { root.toggle-prompt-random(); }
                            }
                        }

                        Text {
                            text: root.prompt-random-active
                                ? "🎲 En cada generación se elige al azar uno de los prompts guardados; el randomizer se aplica encima. Guardados: " + root.prompt-slots-summary
                                : "Guardados: " + root.prompt-slots-summary;
                            color: root.prompt-random-active ? Theme.cyan : Theme.text-dim;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                    }
                }

                TGroupBox {
                    title: "🎲 Randomizer (Modo A)";

                    VerticalLayout {
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 8px;
                            TButton {
                                text: root.rand-active ? "🎲  Aleatorio: ON" : "🎲  Aleatorio: OFF";
                                min-height: 32px;
                                horizontal-stretch: 1;
                                use-accent-color: root.rand-active;
                                accent-color: Theme.accent;
                                clicked => { root.toggle-randomizer(); }
                            }
                            TButton {
                                text: root.super-rand-active
                                    ? "🎰  Super Randomizer: ON"
                                    : "🎰  Super Randomizer: OFF";
                                min-height: 32px;
                                horizontal-stretch: 1;
                                use-accent-color: root.super-rand-active;
                                accent-color: Theme.purple;
                                clicked => { root.toggle-super-randomizer(); }
                            }
                        }

                        // Un solo renglón de ayuda que cambia según el estado,
                        // para que nunca haya dudas de quién manda sobre las
                        // casillas.
                        Text {
                            text: root.super-rand-active
                                ? "🎰 Super Randomizer: en cada generación se sortea cuántas categorías entran (de 1 a 21) y cuáles. Las casillas muestran el sorteo; tu selección manual se conserva y vuelve al apagarlo."
                                : (root.rand-active
                                    ? ""
                                    : "Las casillas se activan con el randomizer en ON.");
                            visible: root.super-rand-active || !root.rand-active;
                            color: root.super-rand-active ? Theme.purple : Theme.text-dim;
                            font-size: 10px;
                            wrap: word-wrap;
                        }

                        // Rejilla fija: en un GridLayout las columnas se
                        // alinean entre filas por construcción. Con
                        // HorizontalLayout + horizontal-stretch cada casilla
                        // acababa con el ancho de su propio texto, porque el
                        // stretch sólo reparte el espacio *sobrante*: por eso
                        // "Orientación" y "Medias" no caían en la misma
                        // columna.
                        GridLayout {
                            spacing: 6px;

                            Row {
                                Text { text: "Reemplazar:"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; width: 90px; }
                                TCheckBox { text: "Uñas";        checked <=> root.chk-nails;      enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                TCheckBox { text: "Orientación"; checked <=> root.chk-orient;     enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                TCheckBox { text: "Expresión";   checked <=> root.chk-expression; enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            Row {
                                Text { text: "Inyectar:"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
                                TCheckBox { text: "Ropa";      checked <=> root.chk-outfit;      enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                TCheckBox { text: "Medias";    checked <=> root.chk-legwear;     enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                TCheckBox { text: "Escenario"; checked <=> root.chk-environment; enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                TCheckBox { text: "Atmósfera"; checked <=> root.chk-atmosphere;  enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                            }

                            Row {
                                Rectangle { }
                                TCheckBox { text: "Pose";           checked <=> root.chk-pose;     enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                TCheckBox { text: "Luz";            checked <=> root.chk-lighting; enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                TCheckBox { text: "Cámara";         checked <=> root.chk-camera;   enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                TCheckBox { text: "Detalles raros"; checked <=> root.chk-rare;     enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                            }

                            Row {
                                Text { text: "Personaje:"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
                                TCheckBox { text: "Accesorios"; checked <=> root.chk-accessories; enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                TCheckBox { text: "Maquillaje"; checked <=> root.chk-makeup;      enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                TCheckBox { text: "Silueta";    checked <=> root.chk-body-type;   enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                TCheckBox { text: "Edad";       checked <=> root.chk-age-vibe;    enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                            }

                            Row {
                                Text { text: "Escena:"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
                                TCheckBox { text: "Paleta color"; checked <=> root.chk-color-palette; enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                TCheckBox { text: "Hora del día"; checked <=> root.chk-time-of-day;   enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                TCheckBox { text: "Clima";        checked <=> root.chk-weather;       enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            Row {
                                Rectangle { }
                                TCheckBox { text: "Props fondo"; checked <=> root.chk-bg-props; enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                TCheckBox { text: "Material";    checked <=> root.chk-material; enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                TCheckBox { text: "Movimiento";  checked <=> root.chk-motion;   enabled: root.rand-active && !root.super-rand-active; horizontal-stretch: 1; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }

            // ── MODO B ──
            if root.current-mode == 1: TGroupBox {
                title: "🎰 Auto-generador (Modo B)";

                VerticalLayout {
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Tema:"; color: Theme.text-dim; font-size: 11.5px; vertical-alignment: center; width: 50px; }
                        TComboBox {
                            model: root.theme-list;
                            current-index <=> root.theme-index;
                            horizontal-stretch: 1;
                        }
                        TCheckBox { text: "Combos curados"; checked <=> root.chk-curated; }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        TButton {
                            text: "🎰  Generar nuevo prompt";
                            min-height: 32px;
                            horizontal-stretch: 1;
                            clicked => { root.gen-preview-b(); }
                        }
                        TCheckBox { text: "Auto en loop"; checked <=> root.chk-auto-b; }
                    }
                }
            }

            // ── Preview ──
            TGroupBox {
                title: "Preview del prompt";
                TTextEdit {
                    text <=> root.preview-text;
                    read-only: true;
                    height: 72px;
                }
            }

            // ── Image-to-Image ──
            TGroupBox {
                title: "🖼 Image-to-Image Conditioning";

                VerticalLayout {
                    spacing: 9px;

                    RefImageRow {
                        label: "Img 1 (persona)"; dot: root.ref-image-loaded ? "🟢" : "⚪";
                        hint: "Sin imagen — solo texto";
                        slot: 1; max-refs: root.model-max-refs;
                        path: root.ref-image-path; loaded: root.ref-image-loaded;
                        tone: Theme.green; tint: Theme.tint-green;
                        browse => { root.browse-ref-image(); }
                        clear  => { root.clear-ref-image(); }
                    }
                    RefImageRow {
                        label: "Img 2 (escena)"; dot: root.ref-image2-loaded ? "🔵" : "⚪";
                        hint: "Opcional — segunda referencia";
                        slot: 2; max-refs: root.model-max-refs;
                        path: root.ref-image2-path; loaded: root.ref-image2-loaded;
                        tone: Theme.cyan; tint: Theme.tint-cyan;
                        browse => { root.browse-ref-image2(); }
                        clear  => { root.clear-ref-image2(); }
                    }
                    RefImageRow {
                        label: "Img 3 (extra)"; dot: root.ref-image3-loaded ? "🟣" : "⚪";
                        hint: "Opcional — referencia adicional";
                        slot: 3; max-refs: root.model-max-refs;
                        path: root.ref-image3-path; loaded: root.ref-image3-loaded;
                        tone: Theme.purple; tint: Theme.tint-purple;
                        browse => { root.browse-ref-image3(); }
                        clear  => { root.clear-ref-image3(); }
                    }
                    RefImageRow {
                        label: "Img 4 (extra)"; dot: root.ref-image4-loaded ? "🟠" : "⚪";
                        hint: "Opcional — referencia adicional";
                        slot: 4; max-refs: root.model-max-refs;
                        path: root.ref-image4-path; loaded: root.ref-image4-loaded;
                        tone: Theme.orange; tint: Theme.tint-orange;
                        browse => { root.browse-ref-image4(); }
                        clear  => { root.clear-ref-image4(); }
                    }
                    RefImageRow {
                        label: "Img 5 (extra)"; dot: root.ref-image5-loaded ? "🟡" : "⚪";
                        hint: "Opcional — referencia adicional";
                        slot: 5; max-refs: root.model-max-refs;
                        path: root.ref-image5-path; loaded: root.ref-image5-loaded;
                        tone: Theme.yellow; tint: Theme.tint-yellow;
                        browse => { root.browse-ref-image5(); }
                        clear  => { root.clear-ref-image5(); }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Modo I2I:";
                            color: root.ref-image-loaded ? Theme.text : Theme.text-dim;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                            width: 110px;
                        }
                        TComboBox {
                            model: [
                                "Referencia de estilo  (el prompt guía el contenido)",
                                "Edición directa  (transforma la imagen)"
                            ];
                            current-index <=> root.i2i-mode-index;
                            enabled: root.ref-image-loaded;
                            horizontal-stretch: 1;
                        }
                    }

                    Text {
                        // El texto sale del modelo elegido, no de una lista
                        // de nombres escrita a mano que se queda vieja.
                        text: {
                            if (root.ref-images-loaded == 0) {
                                root.model-max-refs == 0
                                    ? "ℹ El modelo elegido es solo texto→imagen: no acepta imágenes de referencia."
                                    : root.model-max-refs == 1
                                        ? "ℹ El modelo elegido admite una sola imagen de referencia."
                                        : "ℹ El modelo elegido admite hasta " + root.model-max-refs + " imágenes de referencia."
                            } else if (root.ref-images-loaded > root.model-max-refs) {
                                "⚠ Has cargado " + root.ref-images-loaded + " imágenes y el modelo elegido solo usa "
                                    + root.model-max-refs + ": las demás se descartarán."
                            } else {
                                "✅ " + root.ref-images-loaded + " de " + root.model-max-refs
                                    + " imágenes de referencia en uso. El randomizer sigue activo."
                            }
                        };
                        color: root.ref-images-loaded > root.model-max-refs ? Theme.orange
                             : root.ref-images-loaded > 0 ? Theme.green
                             : Theme.text-dim;
                        font-size: 10.5px;
                        wrap: word-wrap;
                    }
                }
            }

            // ── Configuración ──
            TGroupBox {
                title: "Configuración";
                VerticalLayout {
                    spacing: 7px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Modelo:"; color: Theme.text-dim; font-size: 11.5px; vertical-alignment: center; width: 58px; }
                        TComboBox {
                            model: root.model-list;
                            current-index <=> root.model-index;
                            horizontal-stretch: 1;
                        }
                        Text { text: "Resolución:"; color: Theme.text-dim; font-size: 11.5px; vertical-alignment: center; }
                        TComboBox {
                            model: ["Auto", "1k (1024)", "2k (2048)", "4k (4096)"];
                            current-index <=> root.resolution-idx;
                            width: 118px;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Intervalo:"; color: Theme.text-dim; font-size: 11.5px; vertical-alignment: center; width: 58px; }
                        TSpinBox {
                            value <=> root.interval-secs;
                            minimum: 10;
                            maximum: 600;
                            step: 5;
                        }
                        Text { text: "segundos entre imágenes (modo Loop)"; color: Theme.text-dim; font-size: 10.5px; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Carpeta:"; color: Theme.text-dim; font-size: 11.5px; vertical-alignment: center; width: 58px; }
                        TLineEdit { text <=> root.output-folder; horizontal-stretch: 1; }
                        TButton { text: "📂"; width: 44px; clicked => { root.browse-folder(); } }
                    }
                }
            }

            // ── Notificaciones ──
            TGroupBox {
                title: "🔔 Notificaciones de escritorio";
                VerticalLayout {
                    spacing: 7px;

                    HorizontalLayout {
                        spacing: 8px;
                        TButton {
                            text: root.notify-enabled
                                ? "🔔  Notificaciones: ON"
                                : "🔕  Notificaciones: OFF";
                            min-height: 30px;
                            width: 230px;
                            use-accent-color: root.notify-enabled;
                            accent-color: Theme.green;
                            clicked => { root.toggle-notifications(); }
                        }
                        TButton {
                            text: "Probar aviso";
                            min-height: 30px;
                            width: 130px;
                            enabled: root.notify-enabled;
                            clicked => { root.test-notification(); }
                        }
                        Text {
                            text: "Avisa aunque la ventana esté minimizada o en otro escritorio.";
                            color: Theme.text-dim;
                            font-size: 10px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                    }

                    GridLayout {
                        spacing: 6px;
                        Row {
                            Text { text: "Avisar de:"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; width: 90px; }
                            TCheckBox { text: "Generación correcta"; checked <=> root.notify-success; enabled: root.notify-enabled; horizontal-stretch: 1; }
                            TCheckBox { text: "Timeout del servidor"; checked <=> root.notify-timeout; enabled: root.notify-enabled; horizontal-stretch: 1; }
                        }
                        Row {
                            Rectangle { }
                            TCheckBox { text: "Rechazo por contenido"; checked <=> root.notify-policy; enabled: root.notify-enabled; horizontal-stretch: 1; }
                            TCheckBox { text: "Otros errores"; checked <=> root.notify-other; enabled: root.notify-enabled; horizontal-stretch: 1; }
                        }
                    }

                    Text {
                        text: "En Burst, «Generación correcta» puede producir cientos de avisos: viene desactivado a propósito.";
                        visible: root.notify-success;
                        color: Theme.orange;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }

            // ── Controles ──
            HorizontalLayout {
                spacing: 8px;
                TButton {
                    text: "▶  Iniciar Loop";
                    enabled: !root.is-running;
                    primary: !root.is-running;
                    min-height: 38px;
                    horizontal-stretch: 1;
                    clicked => { root.start-loop(); }
                }
                TButton {
                    text: "⚡⚡ Burst";
                    enabled: !root.is-running;
                    use-accent-color: !root.is-running;
                    accent-color: Theme.orange;
                    min-height: 38px;
                    horizontal-stretch: 1;
                    clicked => { root.start-burst(); }
                }
                TButton {
                    text: "■  Detener";
                    enabled: root.is-running;
                    use-accent-color: root.is-running;
                    accent-color: Theme.red;
                    min-height: 38px;
                    horizontal-stretch: 1;
                    clicked => { root.stop-loop(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                TButton {
                    text: "⚡ Generar 1";
                    enabled: !root.is-running;
                    min-height: 30px;
                    horizontal-stretch: 1;
                    clicked => { root.single-generate(); }
                }
                Rectangle {
                    horizontal-stretch: 2;
                    Text {
                        text: "Loop: espera X segundos entre imágenes · Burst: continuo, sin pausa";
                        color: Theme.text-dim;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            // ── Progreso ──
            VerticalLayout {
                spacing: 5px;
                HorizontalLayout {
                    spacing: 10px;
                    TProgress {
                        progress: root.progress-value;
                        indeterminate: root.progress-indeterminate;
                        horizontal-stretch: 1;
                    }
                    Text { text: root.countdown-text; color: Theme.accent; font-size: 15px; font-weight: 700; width: 58px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { text: root.generation-count; color: Theme.accent; font-size: 22px; font-weight: 800; width: 48px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { text: "imgs"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
                }
                Text {
                    text: root.progress-label;
                    color: root.progress-label == "Completado" ? Theme.green
                         : root.progress-label == "Error"      ? Theme.red
                         : root.progress-label == "Detenido"   ? Theme.text-dim
                         : Theme.cyan;
                    font-size: 11px;
                    horizontal-alignment: right;
                }
            }

            // ── Log ──
            TGroupBox {
                title: "Log";
                TTextEdit {
                    text <=> root.log-text;
                    read-only: true;
                    stick-to-bottom: true;
                    height: 120px;
                    font-size: 11px;
                }
            }
        }
    }
}
